<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_CarNumberPlate</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(REGEX( TX_Car_Number_Plate__c  , &quot;^[0-9]{1,4}(?!.*(LL|CH))[BCDFGHJKLMNPRSTVWXYZ]{3}&quot;))</errorConditionFormula>
    <errorDisplayField>TX_Car_Number_Plate__c</errorDisplayField>
    <errorMessage>Invalid number plate.</errorMessage>
</ValidationRule>
